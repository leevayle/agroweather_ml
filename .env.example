# ============================================================
# AGROWEATHER ENVIRONMENT CONFIGURATION
# ============================================================


# ============================================================
# MONGODB
# ============================================================

MONGODB_URI=
MONGODB_DATABASE=agroweather


# ============================================================
# FASTAPI
# ============================================================

API_HOST=0.0.0.0
API_PORT=8000


# ============================================================
# MQTT
# ============================================================

MQTT_BROKER_HOST=
MQTT_BROKER_PORT=8883

MQTT_USERNAME=
MQTT_PASSWORD=

MQTT_TOPIC=agroweather/station/01/weather

MQTT_CLIENT_ID=agroweather-server


# ============================================================
# FRONTEND CORS
# ============================================================

CORS_ORIGINS=http://localhost:5173,http://localhost:8443


# ============================================================
# FORECAST CACHE
# ============================================================

# Number of forecast days generated and kept in RAM
# when the FastAPI application starts.

FORECAST_CACHE_DAYS=7


# ============================================================
# MACHINE LEARNING
# ============================================================

ML_DATA_PATH=ml/data/kisii_consecutive.csv

ML_MODEL_DIR=ml/models


JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Contact form delivery
CONTACT_EMAIL=
# Example for Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587
# Use a provider-issued app password/token, not your normal account password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Gemini-powered farm chat (required for POST /chat)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash